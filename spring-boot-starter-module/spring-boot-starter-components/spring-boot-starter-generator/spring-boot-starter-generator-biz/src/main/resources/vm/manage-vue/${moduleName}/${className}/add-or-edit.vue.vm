<template>
	<el-dialog v-model="visible" :title="!dataForm.id ? '新增' : '修改'" :close-on-click-modal="false">
		<el-form ref="dataFormRef" :model="dataForm" :rules="dataRules" label-width="100px" @keyup.enter="submitHandle()">
			#foreach($field in $columns)
				#if($field.formType == 'text')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-input v-model="dataForm.$!{field.javaField}" placeholder="$!{field.columnComment}"></el-input>
					</el-form-item>
				#elseif($field.formType == 'textarea')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-input type="textarea" v-model="dataForm.$!{field.javaField}"></el-input>
					</el-form-item>
				#elseif($field.formType == 'editor')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-input type="textarea" v-model="dataForm.$!{field.javaField}"></el-input>
					</el-form-item>
				#elseif($field.formType == 'select')
					#if($field.formDict)
						<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
							<ma-dict-select v-model="dataForm.$!{field.javaField}" dict-type="$!{field.javaField}" placeholder="$!{field.columnComment}"></ma-dict-select>
						</el-form-item>
					#else
						<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
							<el-select v-model="dataForm.$!{field.javaField}" placeholder="请选择">
								<el-option label="请选择" value="0"></el-option>
							</el-select>
						</el-form-item>
					#end
				#elseif($field.formType == 'radio')
					#if($field.formDict)
						<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
							<ma-dict-radio v-model="dataForm.$!{field.javaField}" dict-type="$!{field.formDict}"></ma-dict-radio>
						</el-form-item>
					#else
						<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
							<el-radio-group v-model="dataForm.$!{field.javaField}">
								<el-radio :label="0">启用</el-radio>
								<el-radio :label="1">禁用</el-radio>
							</el-radio-group>
						</el-form-item>
					#end
				#elseif($field.formType == 'checkbox')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-checkbox-group v-model="dataForm.$!{field.javaField}">
							<el-checkbox label="启用" name="type"></el-checkbox>
							<el-checkbox label="禁用" name="type"></el-checkbox>
						</el-checkbox-group>
					</el-form-item>
				#elseif($field.formType == 'date')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-date-picker type="date" placeholder="$!{field.columnComment}" v-model="dataForm.$!{field.javaField}"></el-date-picker>
					</el-form-item>
				#elseif($field.formType == 'datetime')
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-date-picker type="datetime" placeholder="$!{field.columnComment}" v-model="dataForm.$!{field.javaField}"></el-date-picker>
					</el-form-item>
				#else
					<el-form-item label="$!{field.columnComment}" prop="$!{field.javaField}">
						<el-input v-model="dataForm.$!{field.javaField}" placeholder="$!{field.columnComment}"></el-input>
					</el-form-item>
				#end
			#end
		</el-form>
		<template #footer>
			<el-button @click="visible = false">取消</el-button>
			<el-button type="primary" @click="submitHandle()">确定</el-button>
		</template>
	</el-dialog>
</template>

<script setup lang="ts">
	import { reactive, ref } from 'vue'
	import { ElMessage } from 'element-plus/es'
	import service from '@/utils/request'

	const emit = defineEmits(['refreshDataList'])

	const visible = ref(false)
	const dataFormRef = ref()

	const dataForm = reactive({
		#foreach($field in $columns)
				$!{field.javaField}: ''
			#if($foreach.hasNext),#end
		#end
	})

	const init = (id?: number) => {
		visible.value = true
		dataForm.id = ''

		// 重置表单数据
		if (dataFormRef.value) {
			dataFormRef.value.resetFields()
		}

		if (id) {
			get${ClassName}(id)
		}
	}

	const get${ClassName} = (id: number) => {
		service.get('/mgt/${moduleName}/${className}/queryById?id=' + id).then(res => {
			Object.assign(dataForm, res.data)
		})
	}

	const dataRules = ref({
		#foreach($field in $columns)
			#if($field.isRequired)
					$!{field.javaField}: [{ required: true, message: '必填项不能为空', trigger: 'blur' }]
				#if($foreach.hasNext),#end
			#end
		#end
	})

	// 表单提交
	const submitHandle = () => {
		dataFormRef.value.validate((valid: boolean) => {
			if (!valid) {
				return false
			}
			let http: any
			if (dataForm.id) {
				http =  service.post('/mgt/${moduleName}/${className}/edit', dataForm)
			} else {
				http =  service.post('/mgt/${moduleName}/${className}/add', dataForm)
			}
			http.then(() => {
				ElMessage.success({
					message: '操作成功',
					duration: 500,
					onClose: () => {
						visible.value = false
						emit('refreshDataList')
					}
				})
			})
		})
	}

	defineExpose({
		init
	})
</script>