<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>pub.module</groupId>
        <artifactId>tg-boot</artifactId>
        <version>3.5.0</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>spring-boot-starter-runner</artifactId>
    <!-- 新增：跳过该模块的部署和安装（核心配置） -->
    <properties>
        <!-- 跳过部署到远程仓库（Sonatype） -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <!-- 跳过安装到本地仓库（可选，如需本地使用可注释） -->
        <!-- <maven.install.skip>true</maven.install.skip> -->
        <!-- 跳过Spring Boot胖JAR打包（仅保留普通JAR） -->
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.sqlserver</groupId>
                    <artifactId>sqljdbc4</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.dameng</groupId>
                    <artifactId>Dm8JdbcDriver18</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.27</version>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-customer-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-web-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-log-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-dict-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-excel-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-ocr-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-wechat-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-system-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-finance-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-cache-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-im-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-cms-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-file-biz</artifactId>
        </dependency>


        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-dating-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-trade-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-generator-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-security-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>pub.module</groupId>
            <artifactId>spring-boot-starter-data-biz</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <!-- 强制UTF-8编码 -->
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <filtering>false</filtering> <!-- 核心：关闭过滤 -->
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.json</include>
                    <include>**/*.ftl</include>
                </includes>
            </resource>
            <resource>
                <filtering>true</filtering> <!-- 核心：开启过滤，替换占位符 -->
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.yml</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <!-- 对于不需要过滤的资源，单独配置 -->
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.yml</exclude>
                    <exclude>**/*.properties</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
