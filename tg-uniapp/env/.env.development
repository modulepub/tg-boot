# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'

VITE_APP_VERSION = '1.0.0'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后台请求地址（开发时替换为本地或测试环境）
VITE_SERVER_BASEURL = 'http://localhost:9999'

# H5跳转地址前缀（用于 webview 外链跳转）
VITE_H5_JUMP_BASE_URL = 'https://m.example.com'

# pages/h5 实名页「发起实名」跳转（与 matchmaker-app 中 VITE_TENCENT_REALNAME_URL 保持一致）
# VITE_TENCENT_REALNAME_URL = 'https://...'

# pages/h5/contactUs 展示用（可选）
# VITE_CONTACT_HOTLINE = ''
# VITE_CONTACT_EMAIL = ''
# VITE_CONTACT_HOURS = '工作日 9:00 - 18:00'

# 首页 CMS：站点根栏目 nodeCode（与子节点 parent 一致）
VITE_CMS_SITE_NODE_CODE = 'matchmakerWebSite'
# VITE_SITE_BRAND_NAME = '亲亲'
