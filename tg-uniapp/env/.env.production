# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'

# 与 manifest.config.ts 中 versionName 保持一致
VITE_APP_VERSION = '1.0.0'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后台请求地址
VITE_SERVER_BASEURL = 'https://api.iqingqing.net'

# H5跳转地址前缀（用于 webview 外链跳转）
VITE_H5_JUMP_BASE_URL = 'https://m.xxx.com'

# 首页 CMS 站点根栏目 nodeCode、站点名称（可选）
VITE_CMS_SITE_NODE_CODE = 'matchmakerWebSite'
# VITE_SITE_BRAND_NAME=
