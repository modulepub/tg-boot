											<view style="font-size: 26rpx;color: #bababa;">身高</view>
											<view  style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userHeight?item.userHeight+'cm':'--'}}</view>
										</view>
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
