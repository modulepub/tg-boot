												<view style="margin: 0 40rpx;color: #333333;font-weight: 500;font-size: 36rpx;max-width: 180rpx; white-space: nowrap;overflow: hidden;text-overflow: ellipsis; ">{{item.userNickName}}</view>
												<text v-if="item.userSexCode=='1'" style="width: 30rpx;height: 30rpx;" class="text-blue">♂</text>
