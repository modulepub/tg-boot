											<view style="font-size: 26rpx;color: #bababa;">职业</view>
											<view  style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userOccupationName?item.userOccupationName:'--'}}</view>
										</view>
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">房产认证</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userHpcExamineCode?$dict.translate("userHpcExamineCode",item.userHpcExamineCode):'--'}}</view>
										</view>
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">车产认证</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userVlExamineCode?$dict.translate("userVlExamineCode",item.userVlExamineCode):'--'}}</view>
										</view>
									</view>
									<view style="display: flex;justify-content: space-between;align-items: center;margin-top: 20rpx;">

										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">年收入</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userIncome?item.userIncome:'--'}}</view>
										</view>
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">婚姻状况</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userMaritalStatusCode?$dict.translate("userMaritalStatusCode",item.userMaritalStatusCode):'--'}}</view>
										</view>
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">故乡</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userBirthplaceAreaCode?$dict.translate("userBirthplaceAreaCode",item.userBirthplaceAreaCode):'--'}}</view>
										</view>
									</view>
									<view style="display: flex;flex-wrap: wrap;align-items: center;">
									</view>
									<view style="height: 20rpx;"></view>
								</view>

								<view style="background-color: #fff;color: #333333;margin-top: 30rpx;padding: 20px 32rpx;border-radius: 40rpx;">
									<view style="display: flex;align-items: center;margin-bottom: 20rpx;">
										<image src="@/static/icon/xingqu.png" style="width: 30rpx;height: 30rpx;margin-right: 20rpx;"></image>
										<view style="font-size: 28rpx;font-weight: 600;color: #333333;">兴趣爱好 </view>
									</view>
