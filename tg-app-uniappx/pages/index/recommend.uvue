										<view style="font-size: 28rpx;font-weight: 600;color: #3D3D3D;">{{item.userInterests?item.userInterests:'-'}}</view>
									</view>
								</view>
								<view style="background-color: #fff;color: #333333;margin-top: 30rpx;padding: 20px 32rpx;border-radius: 40rpx;">
									<view style="display: flex;align-items: center;margin-bottom: 20rpx;">
										<image src="@/static/icon/ganqing.png" style="width: 28rpx;height: 30rpx;margin-right: 20rpx;"></image>
										<view style="font-size: 28rpx;font-weight: 600;color: #333333;">感情观 </view>
									</view>
									<view style="height: 215rpx;border-radius: 29rpx;padding: 20rpx;">
										<view style="font-size: 28rpx;font-weight: 600;color: #3D3D3D;">{{item.userEmotionalPerspective?item.userEmotionalPerspective:'-'}}</view>
									</view>
								</view>

								<view style="margin-top: 160rpx;"></view>
							</view>

							<view>
								<view class="slide-box-icon slide-box-love" :style="{
									opacity: love * 1.5,
									transform: 'scale('+ (love + 1 > 2 ? 2 : love + 1 )  +')',
								}">
									<cl-icon name="heart" size="32" color="#fa547c" />
								</view>
								<view class="slide-box-icon slide-box-dislike"
									  :style="{
									opacity: dislike * 1.5,
									transform: 'scale('+ (dislike + 1 > 2 ? 2 : dislike + 1 )  +')',
								}">
									<cl-icon name="close" size="32" color="#f8ba35" />
								</view>

							</view>
						</template>
					</view>
				</template>
			</scroll-view>
			<view v-if="showMore" mode="bottom" round="20rpx" bgColor="#f5f7fa" :safeAreaInsetBottom="false">
				<view style="width: 100%;text-align: center;height: 100%;">
					<cl-button open-type='share' :custom-style="btnGetCodesss" height="120rpx">将ta推荐给好友</cl-button>
					<view style="opacity: 1;border: 1rpx solid #F5F6FA;"></view>
					<view  @click="goToJubao"  style="height: 120rpx;line-height:120rpx ;background-color: #fff;color: #333333;font-weight: 500;font-size: 30rpx;">匿名举报</view>
					<view style="opacity: 1;border: 1rpx solid #F5F6FA;"></view>
					<view @click="showMore=false" style="height: 120rpx;line-height:120rpx ;background-color: #fff;color: #333333;font-weight: 500;font-size: 30rpx;">取消</view>
				</view>
			</view>



		</scroll-view>
	</view>

</template>

<script lang="ts">
import { defineComponent, ref, onMounted, onShow } from 'vue';

export default defineComponent({
  name: "Recommend",
  setup() {
    const user = ref({});
    const list = ref<any[]>([]);
    const showHn = ref(false);
    const showQx = ref(false);
    const showMore = ref(false);
    const JbForm = ref({});
    const currentNum = ref(0);
    const winWidth = ref(0);
    const winHeigh = ref(0);
    const x = ref({
      start: 0,
      move: 0,
      end: 0
    });
    const y = ref({
      start: 0,
      move: 0,
      end: 0
    });
    const visible = ref(3);
    const currentIndex = ref(0);
    const swipering = ref(false);
    const slideing = ref(false);
    const love = ref(0);
    const dislike = ref(0);
    const member = ref(0);
    const sum = ref(5);
    const templateId = ref<any[]>([]);
    const lognpopshow = ref(false);
    const btnClickType = ref(false);
    const text = ref('');

    const btnGetCodesss = ref({
      border: 'none',
      width: '100%',
      height: '120rpx',
      color: '#333',
      fontWeight: '500',
      fontSize: '30rpx',
      backgroundColor: '#fff',
    });

    const btnGetCodes = ref({
      border: '1rpx solid #646CDB',
      color: '#fff',
      width: '308rpx',
      lineHeight: '100rpx',
      height: '100rpx',
      fontSize: '32rpx',
      fontWeight: '500',
      borderRadius: '51rpx',
      marginTop: '10rpx'
    });

    const getRecommend = () => {
      uni.$http.get('/cus/dating/recommend/list').then((res: any) => {
        list.value = res.data.records;
        console.log('推荐列表', list.value);
      });
    };

    const goToJubao = () => {
      uni.$tool.goTo(`/pages/report/report?userMkuserCode=${list.value[currentIndex.value]?.userCode}`);
    };

    const sendMessage = () => {
      getmsg();
      if (user.value.showstate === 0 && text.value) {
        uni.showToast({
          icon: 'error',
          title: '资料被驳回，请修改！',
        });
        return;
      }
      if (user.value.showstate === 0 || user.value.showstate === 2) {
        uni.showToast({
          icon: 'error',
          title: '请填写资料并等待资料审核通过！',
        });
        return;
      }
      if (user.value.state !== 1) {
        uni.showToast({
          icon: 'error',
          title: '请先双重认证或等待实名审核通过！',
        });
        return;
      }
      uni.navigateTo({
        url: '/pages/messagelist/index?item=' + JSON.stringify(list.value[currentIndex.value])
      });
    };

    const cardTransform = (item: any, index: number) => {
      let css: any = {};
      if (index === currentIndex.value) {
        if (slideing.value) {
          css["transitionDuration"] = `${!swipering.value ? 1000 : 0}ms`;
        } else {
          css["transitionDuration"] = `${!swipering.value ? 300 : 0}ms`;
        }
      }
      return css;
    };

    const touchStart = (e: any, index: number) => {
      if (slideing.value) return;
      if (typeof list.value[index].x === 'undefined' && typeof list.value[index].y === 'undefined') {
        list.value[index].y = 0;
        list.value[index].x = 0;
      }
      swipering.value = true;
      x.value.start = e.touches[0].pageX;
      y.value.start = e.touches[0].pageY;
    };

    const touchMove = (e: any, index: number) => {
      if (slideing.value) return;
      if (list.value.length === index + 1) {
        return;
      }
      x.value.move = e.touches[0].pageX;
      y.value.move = e.touches[0].pageY;

      list.value[index].x = x.value.move - x.value.start;
      list.value[index].y = y.value.move - y.value.start;
      if (Number.parseInt(list.value[index].x) > 0) {
        love.value = Number.parseInt(list.value[index].x) / (100 * 2);
      } else {
        dislike.value = Math.abs(Number.parseInt(list.value[index].x) / (100 * 2));
      }
    };

    const chage = (e: any) => {
      currentNum.value = e.detail.current;
    };

    const touchEnd = (index: number) => {
      if (slideing.value) return;
      swipering.value = false;
      if (list.value.length === index + 1) {
        return;
      }
      if (
        list.value[index].x > 0 &&
        list.value[index].x > winWidth.value / 2 - winWidth.value / 5
      ) {
        touchEndNext(index);
      } else if (
        list.value[index].x < 0 &&
        list.value[index].x < -winWidth.value / 2 + winWidth.value / 5
      ) {
        touchEndNext(index);
      } else {
        list.value[index].x = 0;
        list.value[index].y = 0;
        slideing.value = false;
        love.value = 0;
        dislike.value = 0;
      }
    };

    const touchEndNext = (index: number) => {
      slideing.value = true;
      list.value[index].x = list.value[index].x * 5;
      list.value[index].y = list.value[index].y * 5;
      touchEndDone();
    };

    const touchEndDone = () => {
      setTimeout(() => {
        currentIndex.value++;
        slideing.value = false;
        love.value = 0;
        dislike.value = 0;
        btnClickType.value = false;
      }, 500);
    };

    const like = (type: string) => {
      lognpopshow.value = true;
      if (btnClickType.value) {
        return;
      }
      if (currentIndex.value === list.value.length - 1) {
        uni.$tool.confirm('每天赠送推荐10个嘉宾，如需更多，点击确认填写推荐意向。', true).then(() => {
          uni.$tool.goTo('/pages/dtIntention/dtIntentionList');
        });
        return;
      }
      btnClickType.value = true;
      let w = 0;
      if (type === '1') {
        w = winWidth.value * 1.5;
        love.value = 1;
      } else if (type === '0') {
        w = -winWidth.value * 1.5;
        dislike.value = 1;
      }
      list.value[currentIndex.value].x = w;
      touchEndDone();
    };

    const getmsg = () => {
      // 实现获取消息的逻辑
    };

    const clickImage = () => {
      // 实现点击图片的逻辑
    };

    const clickImg = (images: string[]) => {
      // 实现点击图片预览的逻辑
      uni.previewImage({
        urls: images
      });
    };

    const queryDtMatchApplication = () => {
      // 实现查询匹配应用的逻辑
    };

    onMounted(() => {
      console.log(user.value, 'user');
      const res = uni.getSystemInfoSync();
      winWidth.value = res.windowWidth;
      winHeigh.value = res.windowHeight - 42;
      const userInfo = uni.getStorageSync('user');
      if (userInfo) {
        member.value = userInfo.member;
        if (member.value === 1) {
          sum.value = 10;
        }
      }
    });

    onShow(() => {
      getRecommend();
    });

    return {
      user,
      list,
      showHn,
      showQx,
      showMore,
      JbForm,
      btnGetCodesss,
      btnGetCodes,
      currentNum,
      winWidth,
      winHeigh,
      x,
      y,
      visible,
      currentIndex,
      swipering,
      slideing,
      love,
      dislike,
      member,
      sum,
      templateId,
      lognpopshow,
      btnClickType,
      text,
      getRecommend,
      goToJubao,
      sendMessage,
      cardTransform,
      touchStart,
      touchMove,
      chage,
      touchEnd,
      touchEndNext,
      touchEndDone,
      like,
      getmsg,
      clickImage,
      clickImg,
      queryDtMatchApplication
    };
  }
});

