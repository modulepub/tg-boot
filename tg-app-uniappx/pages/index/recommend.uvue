<!--suppress ALL -->
<template>
	<view>
		<scroll-view class="slide" :style="{
		width: winWidth + 'px',
		height: winHeigh + 'px',
	}">

			<view>
				<view class="slide-footer">
					<view class="slide-footer-btn" @click="like('0')" style="width: 120rpx ;">
						<view class="slide-footer-icon" :style="{
					backgroundColor: '#f8ba35',
					opacity: dislike,
					zIndex: 1
				}">
							<cl-icon name="close" size="40" color="#fff" />
						</view>
						<view class="slide-footer-icon">
							<cl-icon name="close" size="40" color="#666" />
						</view>
					</view>
					<cl-button :custom-style="btnGetCodes" @click="sendMessage" type="primary" color="#646CDB">发消息</cl-button>
					<view class="slide-footer-btn" @click="like('1')">
						<view class="slide-footer-icon" :style="{
					backgroundColor: '#fa547c',
