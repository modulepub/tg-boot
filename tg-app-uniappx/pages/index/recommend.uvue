										</view>
										<!--                  <view @click="navdatailt(user._id)" style="padding: 10rpx;background-color: #F6F5FD;font-size: 24rpx;color: #333;border-radius: 20rpx;">解锁资料</view>-->
									</view>
									<view style="display: flex;justify-content: space-between;align-items: center;margin-top: 20rpx;">
										<view style="display: flex;flex-direction: column;align-items: center;justify-content: space-between;height: 80rpx;width: 160rpx;">
											<view style="font-size: 26rpx;color: #bababa;">年龄</view>
											<view style="font-size: 28rpx;font-weight: 600;color: #333;">{{item.userAge?item.userAge:'--'}}</view>
										</view>
