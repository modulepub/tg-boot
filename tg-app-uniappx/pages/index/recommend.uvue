						</view>
					</view>
				</view>

			</view>
			<scroll-view scroll-y  class="slide-box">
				<template v-for="(item, index) in list">
					<view class="slide-box-item"
						  :key="index"
						  v-if="currentIndex + visible >= index"
						  @click.stop="clickImage"
						  :style="[cardTransform(item, index), {
						'zIndex': list.length - index,
						'opacity': currentIndex + visible - 1 >= index && currentIndex <= index ? 1 : 0,
						'transform': 'rotate(' + ((item.x || 0) / 30 ) +  'deg) translate3d(' + (item.x || 0) + 'px,' + (item.y || 0) + 'px, '+  (currentIndex - index) * 50  +'px)'
					}]">
						<template>
							<view  v-if="item.userAvatar" style="width: 100%;height: 100%;">
								<swiper  class="swiper" :current="0" style="height: 750rpx;background-color: #f4f4f4;">
									<swiper-item  @click="clickImg(item.userAvatar.split(','))" v-for="(itemPhoto,index) in  item.userAvatar.split(',')" :key="index">
										<image style="width: 100%;height: 750rpx;" mode="aspectFill" :src="itemPhoto">
										</image>
									</swiper-item>
