										<view v-if="item.userIdentityCode== '1'" style="border-radius:188rpx 188rpx 188rpx 188rpx;display: flex;align-items: center;width: 100rpx;justify-content: center;" :style="{background:'rgba(160,166,255,0.2)'}">
											<text class="text-sm text-green text-bold">{{ $dict.translate("userIdentityCode",item.userIdentityCode)}}</text>
										</view>
									</view>
									<view style="display: flex;font-size: 32rpx;font-weight: 600;color: #3D3D3D;margin: 20rpx 0;align-items: center;">
										<view style="max-width: 260rpx; white-space: nowrap;overflow: hidden;text-overflow: ellipsis;">{{item.userSchoolName?item.userSchoolName:'--'}}</view>
										<view style="width: 10rpx;height: 10rpx;background-color: #333333;border-radius: 50%;margin: 0 20rpx;"></view>
										<view >{{item.userEducationCode?$dict.translate("userEducationCode",item.userEducationCode):'--'}}</view>
										<view v-if="item.userEducationExamineCode=='1'" style="display: flex;align-items: center;">
