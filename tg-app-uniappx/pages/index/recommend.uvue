									<text class="text-sm">印象分</text>
									<view style="font-size: 28rpx;font-weight: 500;color: #fff;margin-left: 10rpx;">9.1</view>
								</view>

								<navigator style="position: fixed;right: 30rpx;top: 600rpx;background-color: rgba(0, 0, 0, 0.5);border-radius: 20rpx;text-align: center;padding: 15rpx;display: flex;align-items: center;">
									<view style="font-size: 26rpx;font-weight: 500;color: #fff;"><text class="cuIcon-location"></text>相距{{item.userMutualDistance?item.userMutualDistance:'--'}}KM</view>
								</navigator>
								<view v-if="item.userAvatar"  class="indicator" style="position: relative; bottom: 70rpx;">
									<view class="indicator__dot" v-for="(itemclass, indexclss) in item.userAvatar.split(',')" :key="indexclss"  :class="[indexclss === currentNum && 'indicator__dot--active']"   > </view>
								</view>
							</view>
