										<view v-else style="display: flex;align-items: center;">
											<view style="width: 10rpx;height: 10rpx;background-color: #333333;border-radius: 50%;margin: 0 20rpx;"></view>
											<view class="text-red" style="height: 48rpx;border-radius: 188rpx 188rpx 188rpx 188rpx;display: flex;align-items: center;padding: 0 10rpx;justify-content: center;background: rgba(191,5,19,0.15);">
												<text class="cuIcon-warn" style="width: 30rpx;height: 30rpx;margin-right: 10rpx;"></text>
